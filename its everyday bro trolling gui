local function make(class, props, holder)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = holder
    return obj
end

local base = "https://raw.githubusercontent.com/IcantAffordSynapse/itseverydaybrotrollgui/main/assets/"

local function loadAsset(filename)
    local assetFunction = getcustomasset or getsynasset

    if not (writefile and assetFunction) then
        warn("Executor does not support custom image assets")
        return ""
    end

    local ok, result = pcall(function()
        local data = game:HttpGet(base .. filename)
        local path = "EverydayBro_" .. filename

        writefile(path, data)

        return assetFunction(path)
    end)

    if ok then
        return result
    end

    warn("Could not load image:", filename, result)
    return ""
end

