local function makeBox(placeholder, y)
    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(193, 28)
    box.Position = UDim2.fromOffset(21, y)
    box.BackgroundColor3 = Color3.fromRGB(57, 57, 57)
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(170, 170, 170)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.TextSize = 18
    box.Font = Enum.Font.SourceSans
    box.ClearTextOnFocus = false
    box.Parent = frame
    return box
end

local username = makeBox("player username", 15)
local message = makeBox("to say", 51)

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(112, 28)
button.Position = UDim2.fromOffset(61, 89)
button.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
button.BorderSizePixel = 0
button.Text = "do it"
button.TextColor3 = Color3.new(1, 1, 1)
button.TextSize = 22
button.Font = Enum.Font.SourceSans
button.Parent = frame

local function findPlayer(input)
    local search = input:lower():match("^%s*(.-)%s*$")
    if search == "" then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == search
        or p.DisplayName:lower() == search then
            return p
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(search, 1, true)
        or p.DisplayName:lower():find(search, 1, true) then
            return p
        end
    end

    return nil
end

button.MouseButton1Click:Connect(function()
    local target = findPlayer(username.Text)
    if not target or message.Text == "" then return end

    local character = target.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    Chat:Chat(head, message.Text, Enum.ChatColor.White)
end)
